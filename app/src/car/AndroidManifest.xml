<?xml version="1.0" encoding="utf-8"?>
<!-- Added on top of the main manifest when the app is built with -PcarVideo=true.

     It offers the app itself, not only its sound, to the display of a car, so that video can
     be watched there while the car is parked; Android Auto closes such an app as soon as the
     car moves. Google opens this to video apps one by one for now, and Google Play turns down
     apps that declare it without having been admitted, so the build for Google Play is made
     without it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:appCategory="video">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
