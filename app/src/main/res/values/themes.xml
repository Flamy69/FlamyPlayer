<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only what is visible before Compose draws its first frame; the real theme lives in Theme.kt. -->
    <style name="Theme.FlamyPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- The video player is black in both the light and the dark theme. -->
    <style name="Theme.FlamyPlayer.Video" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
